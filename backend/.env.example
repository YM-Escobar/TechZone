# Copia este archivo como .env y completa los valores

# Cadena de conexión de Neon (sirve tal cual la entrega Neon: postgresql://...)
DATABASE_URL=postgresql://usuario:password@host.neon.tech/techzone?sslmode=require

# Genera una clave con: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=cambia-esta-clave
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

FRONTEND_URL=http://localhost:4321
CORS_ORIGINS=["http://localhost:4321"]

# Administrador inicial (se crea al arrancar si no existe)
FIRST_ADMIN_EMAIL=admin@techzone.com
FIRST_ADMIN_USERNAME=admin
FIRST_ADMIN_PASSWORD=cambia-esta-contraseña

# Si es true, quien no verificó su correo no puede publicar, comentar ni pedir asesorías
REQUIRE_EMAIL_VERIFICATION=false

# Archivos subidos
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=5

# SMTP opcional: sin SMTP_HOST los correos solo se muestran en la consola
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=TechZone <no-reply@techzone.com>
