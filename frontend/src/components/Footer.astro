---
import Logo from './Logo.astro';
import { CATEGORIES } from '../lib/format';

const year = new Date().getFullYear();
---

<footer class="mt-24 border-t border-ink-800">
  <div class="mx-auto grid max-w-7xl gap-10 px-4 py-12 sm:px-6 md:grid-cols-[1.4fr_1fr_1fr]">
    <div class="max-w-sm">
      <Logo />
      <p class="mt-4 text-sm leading-relaxed text-ink-400">
        Componentes para armar o mejorar tu PC, con fichas técnicas claras y una comunidad que comparte sus builds.
      </p>
    </div>
    <div>
      <p class="label mb-3">Categorías</p>
      <ul class="grid grid-cols-2 gap-x-4 gap-y-2 text-sm md:grid-cols-1">
        {CATEGORIES.slice(0, 6).map((c) => (
          <li><a href={`/productos?category=${c.value}`} class="text-ink-400 hover:text-ink-100">{c.label}</a></li>
        ))}
      </ul>
    </div>
    <div>
      <p class="label mb-3">Cuenta</p>
      <ul class="space-y-2 text-sm">
        <li><a href="/login" class="text-ink-400 hover:text-ink-100">Ingresar</a></li>
        <li><a href="/registro" class="text-ink-400 hover:text-ink-100">Crear cuenta</a></li>
        <li><a href="/perfil" class="text-ink-400 hover:text-ink-100">Mi perfil</a></li>
      </ul>
    </div>
  </div>
  <div class="border-t border-ink-800">
    <p class="mx-auto max-w-7xl px-4 py-5 font-mono text-[11px] text-ink-500 sm:px-6">© {year} TechZone</p>
  </div>
</footer>
