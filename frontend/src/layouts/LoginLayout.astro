
---
import '../styles/global.css';

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#050912" />
    <title>{title} — TechZone</title>
  </head>

  <body class="min-h-screen text-ink-100 antialiased">
    <main class="gaming-bg relative flex min-h-screen items-center justify-center overflow-hidden px-4 py-12">

      <!-- Energía cerúlea y violeta -->
      <div class="glow glow-blue"></div>
      <div class="glow glow-purple"></div>

      <!-- Anillos de energía -->
      <div class="energy-ring ring-one"></div>
      <div class="energy-ring ring-two"></div>

      <!-- Login -->
      <div class="relative z-10 w-full max-w-md">
        <slot />
      </div>

    </main>
  </body>
</html>

<style>
  .gaming-bg {
    background: radial-gradient(ellipse at center, #102438 0%, #080e19 45%, #03060c 100%);
  }

  .glow {
    position: absolute;
    width: 350px;
    height: 350px;
    border-radius: 50%;
    filter: blur(110px);
    pointer-events: none;
  }

  .glow-blue {
    top: -150px;
    left: -100px;
    background: #00bfff55;
  }

  .glow-purple {
    bottom: -160px;
    right: -100px;
    background: #853bff44;
  }

  .energy-ring {
    position: absolute;
    width: 650px;
    height: 650px;
    border: 1px solid #00bfff30;
    border-radius: 50%;
    transform: rotate(-25deg) scaleY(0.35);
    box-shadow: 0 0 35px #00bfff12, inset 0 0 35px #00bfff10;
    pointer-events: none;
  }

  .ring-two {
    width: 850px;
    height: 850px;
    border-color: #8b5cf625;
    transform: rotate(35deg) scaleY(0.35);
  }
</style>
