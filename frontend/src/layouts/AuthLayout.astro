---
import Base from './Base.astro';

interface Props {
  title: string;
  heading: string;
  intro?: string;
}

const { title, heading, intro } = Astro.props;
---

<Base title={title}>
  <div class="mx-auto grid max-w-5xl gap-10 px-4 py-12 sm:px-6 md:grid-cols-[1fr_400px] md:py-20">
    <div class="hidden flex-col justify-between border-l border-ink-800 pl-8 md:flex">
      <div>
        <p class="label text-violet-400">Cuenta TechZone</p>
        <p class="mt-4 max-w-xs text-2xl font-semibold leading-snug tracking-tight">
          Guarda tus builds, comenta en la comunidad y pide asesoría.
        </p>
      </div>
      <ul class="space-y-2 font-mono text-xs text-ink-500">
        <li>— Builds guardadas en tu perfil</li>
        <li>— Historial de asesorías</li>
        <li>— Participación en la comunidad</li>
      </ul>
    </div>

    <div>
      <h1 class="text-2xl font-semibold tracking-tight">{heading}</h1>
      {intro && <p class="mt-2 text-sm text-ink-400">{intro}</p>}
      <div class="mt-8">
        <slot />
      </div>
    </div>
  </div>
</Base>
