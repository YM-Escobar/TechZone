---
import AdminLayout from '../../layouts/AdminLayout.astro';
---

<AdminLayout
  title="Usuarios"
  description="Busca cuentas, revisa su estado y administra los permisos de la comunidad."
>
  <div id="users-message" class="mb-5 text-sm" role="status" aria-live="polite" hidden></div>

  <section class="panel mb-6 overflow-hidden">
    <div class="flex flex-wrap items-center justify-between gap-3 border-b border-ink-800 px-5 py-4">
      <div>
        <p class="label">Directorio</p>
        <h2 class="mt-1 text-lg font-semibold">Cuentas de la plataforma</h2>
      </div>
      <button id="toggle-create-user" class="btn-primary px-3 py-2 text-xs">
        <span aria-hidden="true">+</span> Crear usuario
      </button>
    </div>

    <form id="create-user-form" class="hidden border-b border-ink-800 bg-ink-950/60 p-5">
      <div class="mb-4">
        <p class="label">Nueva cuenta</p>
        <h3 class="mt-1 font-semibold">Registrar usuario</h3>
      </div>
      <div class="grid gap-4 sm:grid-cols-2 xl:grid-cols-3">
        <label class="text-sm text-ink-300">Nombre de usuario
          <input class="field mt-1.5" name="username" required minlength="3" maxlength="50" autocomplete="off" />
        </label>
        <label class="text-sm text-ink-300">Correo
          <input class="field mt-1.5" name="email" type="email" required autocomplete="off" />
        </label>
        <label class="text-sm text-ink-300">Nombre completo
          <input class="field mt-1.5" name="full_name" maxlength="120" />
        </label>
        <label class="text-sm text-ink-300">Contraseña inicial
          <input class="field mt-1.5" name="password" type="password" required minlength="8" maxlength="128" autocomplete="new-password" />
        </label>
        <label class="text-sm text-ink-300">Rol
          <select class="field mt-1.5" name="role">
            <option value="usuario">Usuario</option>
            <option value="asesor">Asesor</option>
            <option value="admin">Administrador</option>
          </select>
        </label>
      </div>
      <div class="mt-4 flex justify-end">
        <button class="btn-primary" type="submit">Crear cuenta</button>
      </div>
    </form>

    <form id="user-filters" class="grid gap-3 border-b border-ink-800 p-5 sm:grid-cols-[1fr_180px_180px_auto]">
      <label class="sr-only" for="user-search">Buscar por usuario o correo</label>
      <input id="user-search" name="search" class="field" type="search" placeholder="Buscar usuario, nombre o correo…" />
      <label class="sr-only" for="user-role">Filtrar por rol</label>
      <select id="user-role" name="role" class="field">
        <option value="">Todos los roles</option>
        <option value="usuario">Usuario</option>
        <option value="asesor">Asesor</option>
        <option value="admin">Administrador</option>
      </select>
      <label class="sr-only" for="user-status">Filtrar por estado</label>
      <select id="user-status" name="is_active" class="field">
        <option value="">Todos los estados</option>
        <option value="true">Activos</option>
        <option value="false">Inactivos</option>
      </select>
      <button class="btn-ghost" type="submit">Filtrar</button>
    </form>

    <div class="overflow-x-auto">
      <table class="w-full min-w-[820px] text-left text-sm">
        <thead class="bg-ink-950/60 font-mono text-[9px] uppercase tracking-wider text-ink-500">
          <tr>
            <th class="px-5 py-3 font-medium">Cuenta</th>
            <th class="px-4 py-3 font-medium">Rol</th>
            <th class="px-4 py-3 font-medium">Estado</th>
            <th class="px-4 py-3 font-medium">Registrado</th>
            <th class="px-5 py-3 text-right font-medium">Acciones</th>
          </tr>
        </thead>
        <tbody id="users-results" class="divide-y divide-ink-800">
          <tr><td colspan="5" class="px-5 py-10 text-center text-sm text-ink-500">Cargando usuarios…</td></tr>
        </tbody>
      </table>
    </div>
    <div class="flex flex-wrap items-center justify-between gap-3 border-t border-ink-800 px-5 py-4">
      <p id="users-count" class="font-mono text-[10px] text-ink-500" aria-live="polite"></p>
      <nav id="users-pager" class="flex items-center gap-2" aria-label="Paginación de usuarios"></nav>
    </div>
  </section>
</AdminLayout>

<script>
  import { api, type Page, type Role, type User } from '../../lib/api';
  import { requireAdminUser } from '../../lib/admin';
  import { date, escapeHtml } from '../../lib/format';

  const PAGE_SIZE = 15;
  const filters = document.getElementById('user-filters') as HTMLFormElement;
  const results = document.getElementById('users-results')!;
  const pager = document.getElementById('users-pager')!;
  const count = document.getElementById('users-count')!;
  const message = document.getElementById('users-message')!;
  const createForm = document.getElementById('create-user-form') as HTMLFormElement;
  const roleLabels: Record<Role, string> = { usuario: 'Usuario', asesor: 'Asesor', admin: 'Admin' };
  let skip = 0;
  let currentAdmin: User | null = null;
  let total = 0;

  function showMessage(text: string, isError = false) {
    message.textContent = text;
    message.className = isError ? 'alert-error mb-5' : 'alert-ok mb-5';
    message.hidden = !text;
  }

  function selectedFilters() {
    const data = new FormData(filters);
    return {
      search: String(data.get('search') ?? '').trim(),
      role: String(data.get('role') ?? ''),
      is_active: String(data.get('is_active') ?? ''),
    };
  }

  async function loadUsers() {
    const selected = selectedFilters();
    results.innerHTML = '<tr><td colspan="5" class="px-5 py-10 text-center text-sm text-ink-500">Buscando cuentas…</td></tr>';
    try {
      const page = await api<Page<User>>('/admin/users', {
        query: {
          skip,
          limit: PAGE_SIZE,
          search: selected.search || undefined,
          role: selected.role || undefined,
          is_active: selected.is_active || undefined,
        },
      });
      total = page.total;
      results.innerHTML = page.items.length
        ? page.items.map((user) => {
          const ownAccount = user.id === currentAdmin?.id;
          const activeTone = user.is_active ? 'border-ok/20 bg-ok/5 text-ok' : 'border-ink-700 bg-ink-850 text-ink-400';
          return `
            <tr class="transition-colors hover:bg-ink-850/50">
              <td class="px-5 py-4">
                <p class="font-medium text-ink-100">${escapeHtml(user.full_name || user.username)}${ownAccount ? ' <span class="font-mono text-[9px] text-violet-300">TÚ</span>' : ''}</p>
                <p class="mt-1 font-mono text-[10px] text-ink-500">@${escapeHtml(user.username)} · ${escapeHtml(user.email)}</p>
              </td>
              <td class="px-4 py-4">
                <label class="sr-only" for="role-${user.id}">Rol de ${escapeHtml(user.username)}</label>
                <select id="role-${user.id}" data-action="role" data-id="${user.id}" data-original="${user.role}" class="field min-w-32 py-2 text-xs" ${ownAccount ? 'disabled title="No puedes cambiar tu propio rol"' : ''}>
                  ${(['usuario', 'asesor', 'admin'] as Role[]).map((role) => `<option value="${role}" ${role === user.role ? 'selected' : ''}>${roleLabels[role]}</option>`).join('')}
                </select>
              </td>
              <td class="px-4 py-4"><span class="inline-flex border px-2 py-1 font-mono text-[9px] uppercase tracking-wider ${activeTone}">${user.is_active ? 'Activo' : 'Inactivo'}</span></td>
              <td class="px-4 py-4 whitespace-nowrap text-xs text-ink-400">${date(user.created_at)}</td>
              <td class="px-5 py-4">
                <div class="flex justify-end gap-2">
                  <button data-action="status" data-id="${user.id}" data-next="${!user.is_active}" class="border border-ink-700 px-2.5 py-1.5 text-[10px] text-ink-300 transition-colors hover:border-violet-500/50 hover:text-violet-300" ${ownAccount ? 'disabled title="No puedes cambiar tu propio estado"' : ''}>${user.is_active ? 'Desactivar' : 'Activar'}</button>
                  <button data-action="delete" data-id="${user.id}" data-username="${escapeHtml(user.username)}" class="border border-danger/30 px-2.5 py-1.5 text-[10px] text-danger transition-colors hover:bg-danger/10" ${ownAccount ? 'disabled title="No puedes eliminar tu propia cuenta"' : ''}>Eliminar</button>
                </div>
              </td>
            </tr>`;
        }).join('')
        : '<tr><td colspan="5" class="px-5 py-10 text-center text-sm text-ink-500">No encontramos cuentas con esos filtros.</td></tr>';

      const start = total === 0 ? 0 : skip + 1;
      const end = Math.min(skip + PAGE_SIZE, total);
      count.textContent = `${start}–${end} de ${total.toLocaleString('es')} cuentas`;
      pager.innerHTML = `
        <button data-page="prev" class="btn-ghost px-3 py-2 text-xs" ${skip === 0 ? 'disabled' : ''}>← Anterior</button>
        <button data-page="next" class="btn-ghost px-3 py-2 text-xs" ${skip + PAGE_SIZE >= total ? 'disabled' : ''}>Siguiente →</button>`;
    } catch (err) {
      results.innerHTML = '<tr><td colspan="5" class="px-5 py-10 text-center text-sm text-danger">No se pudieron cargar las cuentas.</td></tr>';
      showMessage(err instanceof Error ? err.message : 'No se pudieron cargar las cuentas.', true);
    }
  }

  async function main() {
    currentAdmin = await requireAdminUser();
    if (!currentAdmin) return;
    await loadUsers();
  }

  filters.addEventListener('submit', (event) => {
    event.preventDefault();
    skip = 0;
    showMessage('');
    void loadUsers();
  });

  document.getElementById('users-pager')!.addEventListener('click', (event) => {
    const button = (event.target as HTMLElement).closest<HTMLButtonElement>('[data-page]');
    if (!button || button.disabled) return;
    skip = button.dataset.page === 'next' ? skip + PAGE_SIZE : Math.max(0, skip - PAGE_SIZE);
    void loadUsers();
  });

  results.addEventListener('change', async (event) => {
    const select = (event.target as HTMLElement).closest<HTMLSelectElement>('[data-action="role"]');
    if (!select || !currentAdmin) return;
    const role = select.value as Role;
    if (role === select.dataset.original) return;
    select.disabled = true;
    try {
      await api<User>(`/admin/users/${select.dataset.id}/role`, { method: 'PATCH', json: { role } });
      showMessage('El rol se actualizó correctamente.');
      await loadUsers();
    } catch (err) {
      select.value = select.dataset.original ?? 'usuario';
      select.disabled = false;
      showMessage(err instanceof Error ? err.message : 'No se pudo actualizar el rol.', true);
    }
  });

  results.addEventListener('click', async (event) => {
    const button = (event.target as HTMLElement).closest<HTMLButtonElement>('[data-action="status"], [data-action="delete"]');
    if (!button) return;
    button.disabled = true;
    try {
      if (button.dataset.action === 'status') {
        await api<User>(`/admin/users/${button.dataset.id}/status`, {
          method: 'PATCH',
          json: { is_active: button.dataset.next === 'true' },
        });
        showMessage('El estado de la cuenta se actualizó.');
      } else {
        const username = button.dataset.username ?? 'esta cuenta';
        if (!confirm(`¿Eliminar la cuenta @${username}? Esta acción no se puede deshacer.`)) {
          button.disabled = false;
          return;
        }
        await api(`/admin/users/${button.dataset.id}`, { method: 'DELETE' });
        showMessage(`La cuenta @${username} fue eliminada.`);
      }
      await loadUsers();
    } catch (err) {
      button.disabled = false;
      showMessage(err instanceof Error ? err.message : 'No se pudo completar la acción.', true);
    }
  });

  document.getElementById('toggle-create-user')!.addEventListener('click', () => {
    createForm.classList.toggle('hidden');
    if (!createForm.classList.contains('hidden')) {
      (createForm.elements.namedItem('username') as HTMLInputElement).focus();
    }
  });

  createForm.addEventListener('submit', async (event) => {
    event.preventDefault();
    const data = new FormData(createForm);
    const submit = createForm.querySelector<HTMLButtonElement>('button[type="submit"]')!;
    submit.disabled = true;
    try {
      const created = await api<User>('/admin/users', {
        method: 'POST',
        json: {
          username: String(data.get('username')).trim(),
          email: String(data.get('email')).trim(),
          full_name: String(data.get('full_name')).trim() || null,
          password: String(data.get('password')),
          role: String(data.get('role')) as Role,
        },
      });
      createForm.reset();
      createForm.classList.add('hidden');
      filters.reset();
      skip = 0;
      showMessage(`La cuenta @${created.username} fue creada.`);
      await loadUsers();
    } catch (err) {
      showMessage(err instanceof Error ? err.message : 'No se pudo crear la cuenta.', true);
    } finally {
      submit.disabled = false;
    }
  });

  void main();
</script>
