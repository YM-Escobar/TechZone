---
import AuthLayout from '../layouts/AuthLayout.astro';
---

<!-- El backend manda aquí el enlace del correo: /reset-password?token=... -->
<AuthLayout title="Nueva contraseña" heading="Nueva contraseña">
  <form id="reset-form" class="space-y-4">
    <div data-alert hidden></div>
    <div>
      <label for="new_password" class="field-label">Contraseña nueva</label>
      <input id="new_password" name="new_password" type="password" class="field" autocomplete="new-password" required minlength="8" />
    </div>
    <div>
      <label for="confirm" class="field-label">Repite la contraseña</label>
      <input id="confirm" name="confirm" type="password" class="field" autocomplete="new-password" required minlength="8" />
    </div>
    <button type="submit" class="btn-primary w-full">Guardar contraseña</button>
  </form>
</AuthLayout>

<script>
  import { api } from '../lib/api';
  import { onSubmit, showAlert } from '../lib/forms';

  const form = document.getElementById('reset-form') as HTMLFormElement;
  const token = new URLSearchParams(location.search).get('token');

  if (!token) {
    showAlert(form.querySelector('[data-alert]'), 'El enlace no es válido. Pide uno nuevo desde "¿Olvidaste tu contraseña?".');
    form.querySelector('button')!.disabled = true;
  }

  onSubmit(form, async (data) => {
    const new_password = String(data.get('new_password') ?? '');
    if (new_password !== data.get('confirm')) throw new Error('Las contraseñas no coinciden.');
    await api('/auth/reset-password', { method: 'POST', json: { token, new_password }, auth: false });
    form.innerHTML = `<div class="alert-ok">Contraseña actualizada. Ya puedes ingresar.</div>
      <a href="/login" class="btn-primary mt-4 w-full">Ir a ingresar</a>`;
  });
</script>
