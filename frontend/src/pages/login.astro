
---
import LoginLayout from '../layouts/LoginLayout.astro';
---

<LoginLayout title="Ingresar">
  <div class="relative overflow-hidden rounded-lg border border-violet-500/30 bg-ink-900/90 p-6 shadow-2xl shadow-violet-950/40 sm:p-9">

    <div class="absolute left-0 top-0 h-1 w-full bg-gradient-to-r from-violet-700 via-violet-400 to-danger"></div>

    <div class="mb-8 text-center">
      <p class="font-mono text-xs uppercase tracking-[0.3em] text-violet-400">
        TECHZONE
      </p>

      <div class="mx-auto my-5 flex size-20 items-center justify-center rounded-xl border border-violet-400/40 bg-violet-500/10">
        <svg viewBox="0 0 80 80" class="size-14" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M15 12H65L70 17V63L65 68H15L10 63V17L15 12Z" stroke="#AD7BFF" stroke-width="2"/>
          <path d="M22 27H58M40 27V55" stroke="#C9A8FF" stroke-width="5"/>
          <path d="M30 42H54L29 56H52" stroke="#FF426F" stroke-width="3"/>
          <circle cx="61" cy="20" r="3" fill="#FF426F"/>
        </svg>
      </div>

      <h1 class="text-2xl font-bold text-white sm:text-3xl">
        BIENVENIDO DE NUEVO
      </h1>

      <p class="mt-2 text-sm text-ink-400">
        Accede a tu centro de gaming.
      </p>
    </div>

    <div class="mb-6 flex items-center gap-3">
      <div class="h-px flex-1 bg-ink-700"></div>
      <span class="font-mono text-[10px] uppercase text-ink-500">
        Inicio de sesión
      </span>
      <div class="h-px flex-1 bg-ink-700"></div>
    </div>

    <form id="login-form" class="space-y-5" novalidate>
      <div data-alert hidden></div>

      <div>
        <label for="identifier" class="field-label">Correo o usuario</label>
        <input
          id="identifier"
          name="identifier"
          class="field border-violet-500/30 bg-ink-950/80 py-3 transition-all duration-300 focus:border-violet-400 focus:shadow-[0_0_12px_rgba(167,139,250,0.25)]"
          placeholder="Ingresa tu usuario"
          autocomplete="username"
          required
        />
      </div>

      <div>
        <div class="flex items-baseline justify-between">
          <label for="password" class="field-label">Contraseña</label>
          <a href="/recuperar" class="text-xs text-violet-400 hover:text-violet-300">
            ¿La olvidaste?
          </a>
        </div>

        <div class="relative">
          <input
            id="password"
            name="password"
            type="password"
            class="field border-violet-500/30 bg-ink-950/80 py-3 pr-20 transition-all duration-300 focus:border-violet-400 focus:shadow-[0_0_12px_rgba(167,139,250,0.25)]"
            placeholder="Ingresa tu contraseña"
            autocomplete="current-password"
            required
          />

          <button
            id="toggle-password"
            type="button"
            class="absolute inset-y-0 right-3 text-xs font-semibold text-violet-400"
          >
            Mostrar
          </button>
        </div>
      </div>

      <button
        type="submit"
        class="w-full rounded-sm bg-gradient-to-r from-violet-700 to-violet-500 px-4 py-3 font-semibold text-white shadow-lg shadow-violet-900/40 transition-all duration-300 hover:-translate-y-1 hover:shadow-[0_0_20px_rgba(139,92,246,0.5)] active:scale-95"
      >
        INGRESAR A TECHZONE
      </button>
    </form>

    <div class="mt-7 border-t border-ink-800 pt-6 text-center">
      <p class="text-sm text-ink-400">
        ¿No tienes cuenta?
        <a href="/registro" class="font-semibold text-violet-400 hover:text-violet-300">
          Crea una
        </a>
      </p>
    </div>

    <p class="mt-6 text-center font-mono text-[9px] uppercase tracking-[0.2em] text-ink-600">
      SYSTEM ACCESS // TECHZONE
    </p>
  </div>
</LoginLayout>

<script>
  import { currentUser, login, nextUrl } from '../lib/session';
  import { onSubmit, str } from '../lib/forms';

  currentUser().then((user) => user && location.replace(nextUrl()));

  const passwordInput = document.getElementById('password') as HTMLInputElement;
  const togglePassword = document.getElementById('toggle-password') as HTMLButtonElement;

  togglePassword.addEventListener('click', () => {
    const ocultar = passwordInput.type === 'password';
    passwordInput.type = ocultar ? 'text' : 'password';
    togglePassword.textContent = ocultar ? 'Ocultar' : 'Mostrar';
  });

  onSubmit(document.getElementById('login-form') as HTMLFormElement, async (data) => {
    const identifier = str(data, 'identifier');
    const password = String(data.get('password') ?? '');

    if (!identifier || !password) {
      throw new Error('Completa tu usuario y contraseña.');
    }

    await login(identifier, password);
    location.href = nextUrl();
  });
</script>

<style>
  [data-alert].alert-error {
    padding: 12px;
    border: 1px solid rgba(255, 66, 111, 0.5);
    border-radius: 6px;
    background: rgba(255, 66, 111, 0.1);
    color: #ff6689;
    font-size: 14px;
    box-shadow: 0 0 12px rgba(255, 66, 111, 0.12);
  }

  [data-alert].alert-ok {
    padding: 12px;
    border: 1px solid rgba(139, 92, 246, 0.5);
    border-radius: 6px;
    background: rgba(139, 92, 246, 0.1);
    color: #c4a5ff;
    font-size: 14px;
  }

  [data-alert][hidden] {
    display: none;
  }
</style>
