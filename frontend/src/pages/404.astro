---
import Base from '../layouts/Base.astro';
---

<Base title="Página no encontrada">
  <div class="mx-auto max-w-7xl px-4 py-24 sm:px-6">
    <p class="font-mono text-sm text-violet-400">404</p>
    <h1 class="mt-3 text-3xl font-semibold tracking-tight">Esta página no existe.</h1>
    <p class="mt-3 text-ink-400">Puede que el enlace esté mal escrito o que la página se haya movido.</p>
    <div class="mt-8 flex gap-3">
      <a href="/" class="btn-primary">Ir al inicio</a>
      <a href="/productos" class="btn-ghost">Ver componentes</a>
    </div>
  </div>
</Base>
