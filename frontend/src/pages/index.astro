---
import Base from '../layouts/Base.astro';
import { CATEGORIES } from '../lib/format';
---

<Base>
  <section class="border-b border-ink-800">
    <div class="mx-auto grid max-w-7xl gap-12 px-4 py-14 sm:px-6 md:py-20 lg:grid-cols-[1.15fr_1fr] lg:gap-16">
      <div class="flex flex-col justify-center">
        <p class="label text-violet-400">Tienda de componentes</p>
        <h1 class="mt-4 max-w-xl text-4xl font-semibold leading-[1.05] tracking-tight text-balance sm:text-5xl lg:text-6xl">
          Arma tu PC pieza por pieza.
        </h1>
        <p class="mt-5 max-w-md text-base leading-relaxed text-ink-400">
          Procesadores, tarjetas de video, memorias y todo lo demás, con la ficha técnica a la vista para comparar antes de comprar.
        </p>
        <form action="/productos" class="mt-8 flex max-w-md gap-2" role="search">
          <label for="hero-search" class="sr-only">Buscar componentes</label>
          <input id="hero-search" name="search" type="search" placeholder="¿Qué estás buscando?" class="field" />
          <button class="btn-primary shrink-0">Buscar</button>
        </form>
      </div>

      <nav aria-label="Categorías" class="border-t border-ink-800 lg:border-t-0">
        <p class="label mb-2 mt-6 lg:mt-0">Categorías</p>
        <ol class="divide-y divide-ink-800 border-y border-ink-800">
          {CATEGORIES.map((c, i) => (
            <li>
              <a href={`/productos?category=${c.value}`} class="group flex items-center gap-4 py-2.5 text-sm">
                <span class="w-6 font-mono text-[11px] text-ink-500">{String(i + 1).padStart(2, '0')}</span>
                <span class="flex-1 text-ink-200 group-hover:text-ink-100">{c.label}</span>
                <span class="font-mono text-[11px] text-ink-500" data-count={c.value}>—</span>
                <span class="text-ink-700 transition-colors group-hover:text-violet-400" aria-hidden="true">→</span>
              </a>
            </li>
          ))}
        </ol>
      </nav>
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-4 pt-14 sm:px-6">
    <div class="mb-5 flex items-end justify-between gap-4">
      <div>
        <p class="label">Catálogo</p>
        <h2 class="mt-1 text-2xl font-semibold tracking-tight">Algunos componentes</h2>
      </div>
      <a href="/productos" class="text-sm text-violet-400 hover:text-violet-300">Ver todo →</a>
    </div>
    <div id="featured" class="grid grid-cols-2 border-l border-t border-ink-800 md:grid-cols-4">
      {Array.from({ length: 8 }).map(() => <div class="aspect-[3/4] animate-pulse border-r border-b border-ink-800 bg-ink-950" />)}
    </div>
  </section>

  <section class="mx-auto mt-20 max-w-7xl px-4 sm:px-6">
    <div class="grid gap-px border border-ink-800 bg-ink-800 md:grid-cols-3">
      <div class="bg-ink-950 p-6">
        <p class="font-mono text-xs text-violet-400">01</p>
        <h3 class="mt-3 font-semibold">Fichas técnicas completas</h3>
        <p class="mt-2 text-sm leading-relaxed text-ink-400">Socket, consumo, frecuencias y medidas en cada producto, para que sepas si es compatible antes de pedirlo.</p>
      </div>
      <div class="bg-ink-950 p-6">
        <p class="font-mono text-xs text-violet-400">02</p>
        <h3 class="mt-3 font-semibold">Builds de la comunidad</h3>
        <p class="mt-2 text-sm leading-relaxed text-ink-400">Mira cómo otros armaron sus equipos, clona una build y ajústala a tu presupuesto.</p>
      </div>
      <div class="bg-ink-950 p-6">
        <p class="font-mono text-xs text-violet-400">03</p>
        <h3 class="mt-3 font-semibold">Asesoría personalizada</h3>
        <p class="mt-2 text-sm leading-relaxed text-ink-400">Cuéntanos qué usos le darás y un asesor te recomienda las piezas.</p>
      </div>
    </div>
  </section>
</Base>

<script>
  import { api, type Page, type Product } from '../lib/api';
  import { escapeHtml, productCard } from '../lib/format';

  const featured = document.getElementById('featured')!;

  api<Page<Product>>('/products', { query: { limit: 8 } })
    .then((page) => {
      featured.innerHTML = page.items.length
        ? page.items.map(productCard).join('')
        : `<p class="col-span-full border-r border-b border-ink-800 bg-ink-950 p-10 text-center text-sm text-ink-400">Todavía no hay productos en el catálogo.</p>`;
    })
    .catch((err) => {
      featured.innerHTML = `<p class="col-span-full border-r border-b border-ink-800 bg-ink-950 p-10 text-center text-sm text-danger">${escapeHtml(err.message)}</p>`;
    });

  // Cantidad de productos por categoría (solo se lee el total)
  document.querySelectorAll<HTMLElement>('[data-count]').forEach((el) => {
    api<Page<Product>>('/products', { query: { category: el.dataset.count, limit: 1 } })
      .then((page) => (el.textContent = String(page.total)))
      .catch(() => (el.textContent = ''));
  });
</script>
